default_platform(:ios)

platform :ios do
  desc "Archive GControl and upload to App Store Connect"
  lane :release do
    api_key = asc_api_key

    build_app(
      scheme: "GControl",
      project: "GControl.xcodeproj",
      export_method: "app-store",
      export_options: {
        method: "app-store",
        signingStyle: "automatic",
        uploadSymbols: true,
        manageAppVersionAndBuildNumber: true
      },
      xcargs: "-allowProvisioningUpdates",
      clean: true
    )

    upload_to_app_store(
      api_key: api_key,
      app_identifier: "com.grooapp.app",
      skip_metadata: true,
      skip_screenshots: true,
      skip_app_version_update: false,
      precheck_include_in_app_purchases: false,
      submit_for_review: false
    )
  end

  desc "Build App Store IPA only (no upload)"
  lane :build do
    asc_api_key
    build_app(
      scheme: "GControl",
      project: "GControl.xcodeproj",
      export_method: "app-store",
      export_options: {
        method: "app-store",
        signingStyle: "automatic",
        uploadSymbols: true
      },
      xcargs: "-allowProvisioningUpdates",
      clean: true,
      output_directory: "./build",
      output_name: "GControl.ipa"
    )
  end

  desc "Upload an already-built IPA to TestFlight"
  lane :tf_upload do
    api_key = asc_api_key
    upload_to_testflight(
      api_key: api_key,
      app_identifier: "com.grooapp.app",
      ipa: "./build/GControl.ipa",
      skip_waiting_for_build_processing: true
    )
  end

  private_lane :asc_api_key do
    key_id = ENV["ASC_API_KEY_ID"]
    issuer_id = ENV["ASC_API_ISSUER_ID"]
    key_path = ENV["ASC_API_KEY_PATH"]

    UI.user_error!("Set ASC_API_KEY_ID, ASC_API_ISSUER_ID and ASC_API_KEY_PATH") if [key_id, issuer_id, key_path].any?(&:nil?)

    app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: File.expand_path(key_path),
      duration: 1200,
      in_house: false
    )
  end
end
