OPENAI_API_KEY=
PORT=3000
NODE_ENV=development

# Shopify (pedidos y montos reales — solo en servidor)
SHOPIFY_SHOP=drgsmileusa
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2025-01
# En desarrollo: si la app no está instalada en Shopify, usa datos de prueba locales
SHOPIFY_DEV_FIXTURE=1
# Opcional: token Admin API directo (Settings → Apps → Develop apps en Shopify)
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_REDIRECT_URI=http://127.0.0.1:3000/api/shopify/callback
SHOPIFY_SCOPES=read_orders,read_products,read_customers

# Instagram (Meta) — Smilestudio Wellness-IG
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Meta Business Manager ID (opcional, referencia)
INSTAGRAM_BUSINESS_ID=
# Token que pegas en Meta → "Verificar token" (tú lo defines)
INSTAGRAM_VERIFY_TOKEN=smilestudio_ig_verify_We2rFa7
# URL pública HTTPS sin slash final (Render / Cloudflare Tunnel / ngrok)
# Ej: https://tu-backend.onrender.com
INSTAGRAM_WEBHOOK_PUBLIC_BASE_URL=
# Opcional: para responder DMs desde la app (IGAA… o EAAB…)
INSTAGRAM_PAGE_ACCESS_TOKEN=
# Instagram Business Account ID (ej. 17841400024368275)
INSTAGRAM_IG_USER_ID=
INSTAGRAM_USERNAME=
# Opcional: Facebook Page ID vinculada (solo token de Page EAAB…)
INSTAGRAM_PAGE_ID=
