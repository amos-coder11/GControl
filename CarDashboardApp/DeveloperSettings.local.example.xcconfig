// 1) Duplica este archivo y renómbralo a: DeveloperSettings.local.xcconfig
// 2) Esa copia NO se sube a git (ya está en .gitignore).
// 3) Pega tu clave real solo en .local, nunca en este .example.

// Pestaña IA (Viera) — solo OpenAI
OPENAI_API_KEY = sk-proj-TU_CLAVE_AQUI
// Recomendado visión (foto del vehículo): gpt-4o · Barato: gpt-4o-mini
// OPENAI_MODEL = gpt-4o

// Generador de contratos (pantalla Contratos IA) — sigue usando Claude si lo configuras
// ANTHROPIC_API_KEY = sk-ant-api03-TU_CLAVE_AQUI
// ANTHROPIC_MODEL = claude-sonnet-4-20250514

// --- Columnas INSERT en `vehicles` (opcional). Por defecto la app usa: ---
// make, model, year, license_plate, price, kilometers, fuel, transmission.
// Ejemplo si tu tabla usa español:
// VEHICLES_COL_BRAND = marca
// VEHICLES_COL_MODEL = modelo
// VEHICLES_COL_MILEAGE = kilometraje
// VEHICLES_COL_FUEL_TYPE = combustible
// URL de portada tras subir fotos (por defecto main_image_url):
// VEHICLES_COL_MAIN_IMAGE_URL = image_url
