<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Para crear en tu calendario el evento del plazo de la tarea cuando pulses «Aceptar» en la notificación.</string>
	<key>NSCalendarsWriteOnlyAccessUsageDescription</key>
	<string>Para añadir el plazo de la tarea a tu calendario (solo crear eventos, sin leer tus citas).</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Para elegir fotos de perfil y adjuntos en el chat.</string>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>tel</string>
	</array>
	<key>NSMicrophoneUsageDescription</key>
	<string>Used to visualize your voice in real time, dictation, and team voice features. Usamos el micrófono para mostrar tu voz en tiempo real, dictado y mensajes de voz.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Transcribimos lo que dices para escribir tareas y mensajes al equipo sin teclear.</string>
	<key>USER_PROFILES_TABLE</key>
	<string>user_profiles</string>
	<key>SHOPIFY_BACKEND_BASE_URL</key>
	<string>$(SHOPIFY_BACKEND_BASE_URL)</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>ANTHROPIC_API_KEY</key>
	<string>$(ANTHROPIC_API_KEY)</string>
	<key>ANTHROPIC_MODEL</key>
	<string>$(ANTHROPIC_MODEL)</string>
	<key>OPENAI_API_KEY</key>
	<string>$(OPENAI_API_KEY)</string>
	<key>OPENAI_MODEL</key>
	<string>$(OPENAI_MODEL)</string>
</dict>
</plist>
